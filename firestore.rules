        && request.resource.data.keys().hasOnly(['alert','action','approved','methodVerified','unit','revision','updatedAt','updatedBy'])
        && request.resource.data.alert is number && request.resource.data.alert >= 0
        && request.resource.data.action is number && request.resource.data.action > request.resource.data.alert
        && request.resource.data.approved == false && request.resource.data.methodVerified == false
        && request.resource.data.revision is int && request.resource.data.revision >= 1
        && request.resource.data.updatedAt == request.time && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }
    match /monitoringAreaAssignments/{weekId} {
      allow get: if active();
      allow list: if admin();
      allow create, update: if admin()
        && request.resource.data.keys().hasOnly(['analystUid','analystName','week','updatedBy','updatedAt'])
        && request.resource.data.week == weekId
        && request.resource.data.analystUid is string
        && request.resource.data.analystName is string
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /monitoringAreaControls/{controlId} {
      allow get, list: if areasRead();
      function validControlCreate() {
        let p = get(/databases/$(database)/documents/monitoringAreaPoints/$(request.resource.data.pointCode)).data;
        let prep = get(/databases/$(database)/documents/microMediaPreparations/$(request.resource.data.preparationId)).data;
        let movement = getAfter(/databases/$(database)/documents/microMediaInventoryMovements/$(controlId)).data;
        return request.resource.data.keys().hasOnly(['pointCode','pointName','pointType','medium','method','microorganism','unit','preparationId','boxCode','executedAt','executedTime','notes','status','createdBy','createdAt','groupId','incubationHours'])
          && request.resource.data.keys().hasAll(['pointCode','pointName','pointType','medium','preparationId','executedAt','executedTime','status','createdBy','createdAt','groupId'])
          && p.active == true && request.resource.data.pointType == p.type
          && ((p.type == 'Ambiente' && request.resource.data.medium in ['PCA','PDA'])
             || (p.type != 'Ambiente' && request.resource.data.medium == p.medium))
          && prep.mediumId == request.resource.data.medium
          && prep.status in ['LIBERADO','LIBERADO_HISTORICO'] && prep.qc == 'CONFORME'
          && (!prep.get('performanceRequired',false) || prep.performance == 'CONFORME')
          && request.resource.data.executedAt >= prep.date
          && request.resource.data.executedAt <= prep.expiry
          && request.resource.data.executedAt >= prep.get('historicalReleaseDate',prep.date)
          && request.resource.data.status == 'PENDIENTE_LECTURA'
          && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time
          && request.resource.data.preparationId is string && request.resource.data.boxCode is string
          && request.resource.data.notes is string && request.resource.data.notes.size() <= 500
          && movement.preparationId == request.resource.data.preparationId && movement.units == 1
