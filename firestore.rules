      allow create: if areasWrite() && validControlCreate();
      allow update: if areasWrite()
        && resource.data.status == 'PENDIENTE_LECTURA'
        && request.resource.data.status == 'PENDIENTE_REVISION_TECNICA'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['incubationHours','incubationCondition','incubationStartDate','incubationStartTime','scheduledDate','scheduledTime','scheduleReason','readingDate','readingTime','observedCount','readingNotes','readingAt','readingBy','status','resultValue','resultUnit','calculationFormula','criteriaSnapshot','evaluation','estimatedUfcM3','plateDiameterMm','exposureMinutes','recoveryVolumeMl','platedVolumeMl','dilutionFactor','swabAreaCm2'])
        && request.resource.data.readingBy == request.auth.uid
        && request.resource.data.readingAt == request.time
        && request.resource.data.incubationHours == (resource.data.medium == 'PDA' ? 120 : 48)
        && request.resource.data.observedCount is int && request.resource.data.observedCount >= 0
        && request.resource.data.readingDate is string && request.resource.data.readingTime is string
        && request.resource.data.readingNotes is string && request.resource.data.readingNotes.size() <= 1000
        && request.resource.data.scheduleReason is string && request.resource.data.scheduleReason.size() <= 300
        && request.resource.data.incubationStartDate is string && request.resource.data.incubationStartTime is string
        && request.resource.data.scheduledDate is string && request.resource.data.scheduledTime is string
        && request.resource.data.evaluation == 'PENDIENTE_REVISION_TECNICA'
        && request.resource.data.resultValue is number && request.resource.data.resultValue >= 0
        && request.resource.data.resultUnit == (resource.data.pointCode == 'MC-AREA-024' ? 'UFC/mL' : resource.data.medium == 'PDA' ? 'UFC/placa/15 min' : 'UFC/cm²')
        && (resource.data.medium != 'PDA' || request.resource.data.estimatedUfcM3 is number)
        && (resource.data.pointCode != 'MC-AREA-024' || (
          resource.data.pointType == 'Agua' && resource.data.medium == 'PCA'
          && request.resource.data.platedVolumeMl == 1
          && request.resource.data.dilutionFactor == 1
          && request.resource.data.resultValue == request.resource.data.observedCount
          && request.resource.data.calculationFormula == 'colonias / volumen sembrado (mL) × factor de dilución'
        ))
        && (resource.data.medium != 'PCA' || resource.data.pointCode == 'MC-AREA-024' || (
          request.resource.data.swabAreaCm2 is number
          && request.resource.data.swabAreaCm2 > 0
          && request.resource.data.calculationFormula is string
          && request.resource.data.calculationFormula.size() > 0
          && request.resource.data.calculationFormula.size() <= 200
          && request.resource.data.resultValue is number
          && request.resource.data.resultValue >= 0
          // El cálculo exacto se verifica en el cliente y debe aprobarlo Calidad.
          // Firestore valida estructura, valores y trazabilidad sin aritmética frágil.
        ));
      // V1.0.324: decisión técnica final, solo ADMIN, sin modificar resultados ni inventario.
      allow update: if admin()
        && resource.data.status == 'PENDIENTE_REVISION_TECNICA'
        && request.resource.data.status in ['CONFORME','NO_CONFORME','EN_REVISION']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','evaluation','reviewReason','reviewedBy','reviewedAt'])
        && request.resource.data.evaluation == request.resource.data.status
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.reviewReason is string
        && request.resource.data.reviewReason.size() >= 0
        && request.resource.data.reviewReason.size() <= 1000
        && resource.data.observedCount is int
        && resource.data.resultValue is number;
      allow delete: if false;
    }
    match /monitoringAreaPoints/{pointId} {
      allow get, list: if areasRead();
      allow create: if areasWrite() && validArea(pointId)
        && request.resource.data.version == 1
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && auditForArea(pointId, 1);
      allow update: if areasWrite() && validArea(pointId)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.code == resource.data.code
        && request.resource.data.version == resource.data.version + 1
        && auditForArea(pointId, request.resource.data.version);
      allow delete: if false;
    }
    match /monitoringAreaAudit/{auditId} {
      allow get, list: if areasRead();
      allow create: if areasWrite()
        && request.resource.data.keys().hasOnly(['code','action','reason','uid','at','version','before','after'])
        && request.resource.data.keys().hasAll(['code','action','reason','uid','at','version','before','after'])
        && auditId == request.resource.data.code + '__v' + string(request.resource.data.version)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.code is string
        && request.resource.data.action in ['new','edit','deactivate','reactivate']
        && request.resource.data.reason is string && request.resource.data.reason.size() <= 500
        && request.resource.data.version is int && request.resource.data.version >= 1
        && request.resource.data.after is map
        && request.resource.data.after.code == request.resource.data.code
        && request.resource.data.after.version == request.resource.data.version
        && getAfter(/databases/$(database)/documents/monitoringAreaPoints/$(request.resource.data.code)).data.version == request.resource.data.version
        && getAfter(/databases/$(database)/documents/monitoringAreaPoints/$(request.resource.data.code)).data.updatedBy == request.auth.uid;
      allow update, delete: if false;
    }

    // V1.0.364 - Limpieza: zona unificada y registros historicos inmutables.
    // El QR requiere autenticacion; no concede permisos por si mismo.
    function cleaningRead() {
      return (active() && get(profilePath()).data.role == 'PERSONAL_LIMPIEZA') || equipmentRead() || (active() && get(profilePath()).data.permissions.get('cleaning','NONE') in ['READ','WRITE']);
    }
    function cleaningWrite() {
      return (active() && get(profilePath()).data.role == 'PERSONAL_LIMPIEZA' && get(profilePath()).data.permissions.get('cleaning','NONE') == 'WRITE') || equipmentWrite() || (active() && get(profilePath()).data.permissions.get('cleaning','NONE') == 'WRITE');
    }
    match /microCleaningRecords/{recordId} {
      allow get, list: if cleaningRead();
      allow create: if cleaningWrite()
        && request.resource.data.keys().hasOnly([
          'element','coveredElements','date','moment','agent','record','frequency',
          'notes','actorUid','actorCode','createdAt','time','historical','recordedAt','sourceId','sourceCollection'])
        && request.resource.data.keys().hasAll([
          'element','coveredElements','date','moment','agent','record','frequency',
          'notes','actorUid','actorCode','createdAt','time','historical','recordedAt'])
        && request.resource.data.element in ['area','floor','surface','des','est','freezer','sterilizer','incubator','fridge2','fridge','hood','balance','ph','turb']
        && (equipmentWrite() || (active() && get(profilePath()).data.role == 'PERSONAL_LIMPIEZA' && get(profilePath()).data.permissions.get('cleaning','NONE') == 'WRITE') || request.resource.data.element in ['area','floor','surface'])
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.date >= (request.resource.data.element == 'area' ? '2026-01-14' : '2026-01-01')
        && request.resource.data.moment in ['INICIO','FINAL','UNICA']
        && (request.resource.data.element != 'area' || request.resource.data.moment in ['INICIO','FINAL'])
        && (request.resource.data.keys().hasAny(['sourceId']) ? (request.resource.data.element in ['hood','balance','ph','turb'] && request.resource.data.sourceId is string && request.resource.data.sourceId.size() > 0 && request.resource.data.sourceCollection in ['microSamples','microMediaPreparations','microStrainPreparations','microStrainReactivations'] && recordId == request.resource.data.element + '_event_' + request.resource.data.sourceId && exists(/databases/$(database)/documents/$(request.resource.data.sourceCollection)/$(request.resource.data.sourceId))) : recordId == request.resource.data.element + '_' + request.resource.data.date + '_' + request.resource.data.moment)
        && request.resource.data.coveredElements is list
        && request.resource.data.coveredElements.size() <= 2
        && (request.resource.data.element != 'area' || request.resource.data.coveredElements == ['Piso · Área Microbiología','Superficies de trabajo · Microbiología'])
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.recordedAt == request.time
        && request.resource.data.historical is bool
        && request.resource.data.agent is string && request.resource.data.agent.size() <= 150
        && request.resource.data.record in ['PG0418','PG0419','PG0420','PG0422']
        && (request.resource.data.element != 'area' || request.resource.data.record == 'PG0418')
        && request.resource.data.frequency is string && request.resource.data.frequency.size() <= 80
        && request.resource.data.notes is string && request.resource.data.notes.size() <= 500
        && request.resource.data.actorCode is string && request.resource.data.actorCode.size() <= 150
        && request.resource.data.time is string && request.resource.data.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && (request.resource.data.element != 'area' || request.resource.data.moment != 'FINAL'
          || exists(/databases/$(database)/documents/microCleaningRecords/$(request.resource.data.element + '_' + request.resource.data.date + '_INICIO')));
      allow update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
