    }
    // V1.0.303: Catálogo de áreas y auditoría obligatoria (transacción atómica).
    function areasRead() {
      return active() && (get(profilePath()).data.role == 'ADMIN'
        || get(profilePath()).data.permissions.get('areas','NONE') in ['READ','WRITE']);
    }
    function areasWrite() {
      return active() && (get(profilePath()).data.role == 'ADMIN'
        || get(profilePath()).data.permissions.get('areas','NONE') == 'WRITE');
    }
    function areaFields() {
      return ['id','frequency','code','name','type','criticality','frequencyDays','medium','microorganism',
        'method','exposureMinutes','plateDiameterMm','swabAreaCm2','limitTarget',
        'limitAlert','limitMax','unit','criteriaSource','active','statusReason',
        'statusChangedAt','version','createdBy','createdAt','updatedBy','updatedAt'];
    }
    function validArea(pointId) {
      return request.resource.data.keys().hasOnly(areaFields())
        && request.resource.data.keys().hasAll(['code','name','type','criticality','frequencyDays',
          'medium','active','version','createdBy','createdAt','updatedBy','updatedAt'])
        && pointId.matches('^MC-AREA-[0-9]{3,6}$')
        && request.resource.data.code == pointId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 150
        && request.resource.data.type in ['Ambiente','Superficie','Agua']
        && request.resource.data.criticality in ['NORMAL','ALTA','CRÍTICA']
        && request.resource.data.frequencyDays in [7,15,30]
        && request.resource.data.medium in ['PDA','PCA']
        && request.resource.data.active is bool
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.version is int && request.resource.data.version >= 1
        && (!request.resource.data.keys().hasAny(['limitTarget']) || request.resource.data.limitTarget is number)
        && (!request.resource.data.keys().hasAny(['limitAlert']) || request.resource.data.limitAlert is number)
        && (!request.resource.data.keys().hasAny(['limitMax']) || request.resource.data.limitMax is number)
        && (!request.resource.data.keys().hasAny(['statusReason']) || request.resource.data.statusReason is string);
    }
    function auditForArea(pointId, version) {
      return getAfter(/databases/$(database)/documents/monitoringAreaAudit/$(pointId + '__v' + string(version))).data.code == pointId
        && getAfter(/databases/$(database)/documents/monitoringAreaAudit/$(pointId + '__v' + string(version))).data.version == version
        && getAfter(/databases/$(database)/documents/monitoringAreaAudit/$(pointId + '__v' + string(version))).data.uid == request.auth.uid;
    }
